[Unit]
Description=BlazeSolver
After=network.target

[Service]
SyslogIdentifier=blazesolver
Restart=always
RestartSec=5
Type=simple
User=blazesolver
Group=blazesolver
Environment="LOG_LEVEL=info"
WorkingDirectory=/opt/blazesolver
ExecStart=/opt/blazesolver/blazesolver
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
